From: spice-mac <spice-mac@localhost>
Date: Mon, 19 Oct 2026 22:17:52 +0200
Subject: [PATCH 05/21] display: build without <drm/drm_fourcc.h>

0.43 includes the Linux DRM header unconditionally for the GL scanout path,
which breaks the build on macOS. Only DRM_FORMAT_MOD_INVALID is used from it,
so include the header where it exists and define that one constant otherwise.
---
 src/channel-display.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/channel-display.c b/src/channel-display.c
index c895ff5..6997f9d 100644
--- a/src/channel-display.c
+++ b/src/channel-display.c
@@ -22,8 +22,15 @@
 #include <glib/gi18n-lib.h>
 
 #ifdef G_OS_UNIX
+#if defined(__has_include) && __has_include(<drm/drm_fourcc.h>)
 #include <drm/drm_fourcc.h>
 #endif
+#ifndef DRM_FORMAT_MOD_INVALID
+/* <drm/drm_fourcc.h> is Linux/BSD only (absent on macOS); this is the one symbol
+ * used from it: fourcc_mod_code(NONE, DRM_FORMAT_RESERVED). */
+#define DRM_FORMAT_MOD_INVALID ((1ULL << 56) - 1)
+#endif
+#endif
 
 #include "spice-client.h"
 #include "spice-common.h"
