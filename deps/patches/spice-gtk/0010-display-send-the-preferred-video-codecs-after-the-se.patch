From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Er Gibbio <gibbio@pm.me>
Date: Tue, 20 Oct 2026 19:52:45 +0200
Subject: [PATCH 10/10] display: send the preferred video codecs after the
 server's display init

SPICE_PREFERRED_VIDEO_CODECS was sent right after DISPLAY_INIT. spice-server
(0.15.2 up to master) handles SPICE_MSGC_DISPLAY_PREFERRED_VIDEO_CODEC_TYPE by
stopping every running stream (video_stream_detach_and_stop), and one that
arrives together with DISPLAY_INIT is handled in the same receive() call, in
display_channel_client_wait_for_init(), before dcc_create_all_streams() has
set our stream agents up. If video is already playing when we connect, the
clip item it queues for us carries a NULL client, and freeing it segfaults
the server's worker in RedChannelClient::get_channel() (~VideoStreamClipItem),
killing QEMU.

Reproduced against spice-server master's test-display-streaming: the server
crashed 17 ms after the preference arrived, with exactly the backtrace above.
Reported upstream as https://gitlab.freedesktop.org/spice/spice/-/issues/99;
not fixed in master ad4b603d nor in the open MR !257 (c363f0dc).

Send the preference at the first MARK instead: the server queues it right
before setting the agents up, in the same call, or when the primary surface
appears later.
---
 src/channel-display.c | 25 +++++++++++++++++++++----
 1 file changed, 21 insertions(+), 4 deletions(-)

diff --git a/src/channel-display.c b/src/channel-display.c
index 0d7df71..7d677d6 100644
--- a/src/channel-display.c
+++ b/src/channel-display.c
@@ -90,6 +90,9 @@ struct _SpiceDisplayChannelPrivate {
     gint32                      playout_shift;
     gint32                      playout_window_min;
     gint64                      playout_window_end;
+#ifdef HAVE_VIDEOTOOLBOX
+    gboolean                    preferred_codecs_pending; /* sent at the next MARK */
+#endif
     SpiceGlScanout              scanout_ret;
     SpiceGlScanout2             scanout;
 };
@@ -1022,9 +1025,17 @@ static void spice_display_channel_set_capabilities(SpiceChannel *channel)
 #ifdef HAVE_VIDEOTOOLBOX
 /* SPICE_PREFERRED_VIDEO_CODECS="h264,mjpeg" asks the server to prefer these codecs.
  * Servers pick from their own list in order (spice:mjpeg first by default), so
- * without it they keep sending MJPEG even to a client that decodes H.264. It is
- * opt-in rather than automatic: spice-server 0.15.2 can crash (taking QEMU down)
- * when a GStreamer-encoded stream is torn down. */
+ * without it they keep sending MJPEG even to a client that decodes H.264.
+ *
+ * It is sent at the first MARK, not with DISPLAY_INIT: spice-server (0.15.2 up
+ * to master) handles the preference by stopping every running stream, and one
+ * that arrives with our DISPLAY_INIT is handled before our stream agents have
+ * been set up: a queued clip item ends up with a NULL client and the server
+ * segfaults freeing it (RedChannelClient::get_channel), taking QEMU down. That
+ * only needs video to be playing when we connect. The server queues MARK in the
+ * same call that sets the agents up (or when the primary surface appears), so
+ * they exist by the time we see it.
+ * https://gitlab.freedesktop.org/spice/spice/-/issues/99 */
 static void display_send_preferred_codecs_from_env(SpiceChannel *channel)
 {
     gint codecs[SPICE_VIDEO_CODEC_TYPE_ENUM_END];
@@ -1249,7 +1260,7 @@ static void spice_display_channel_up(SpiceChannel *channel)
         spice_display_channel_change_preferred_compression(channel, preferred_compression);
     }
 #ifdef HAVE_VIDEOTOOLBOX
-    display_send_preferred_codecs_from_env(channel);
+    SPICE_DISPLAY_CHANNEL(channel)->priv->preferred_codecs_pending = TRUE;
 #endif
 }
 
@@ -1298,6 +1309,12 @@ static void display_handle_mark(SpiceChannel *channel, SpiceMsgIn *in)
 
     c->mark = TRUE;
     g_coroutine_signal_emit(channel, signals[SPICE_DISPLAY_MARK], 0, TRUE);
+#ifdef HAVE_VIDEOTOOLBOX
+    if (c->preferred_codecs_pending) {
+        c->preferred_codecs_pending = FALSE;
+        display_send_preferred_codecs_from_env(channel);
+    }
+#endif
 }
 
 /* coroutine context */
