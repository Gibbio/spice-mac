+/**
+ * SpiceDisplayStreamStats:
+ * @id: the stream id
+ * @codec_type: the stream's #SpiceVideoCodecType
+ * @decoder: what decodes it: "VideoToolbox", "GStreamer" or "built-in"
+ * @width: the stream's width
+ * @height: the stream's height
+ * @frames_received: frames received since the stream was created
+ * @frames_shown: frames shown since the stream was created
+ * @frames_late: frames that arrived after their display time
+ * @frames_dropped: frames the decoder dropped
+ * @playout_delay: ms between the last frame's arrival and its display time
+ * @playout_target: the delay aimed at when no audio is playing, 0 when the
+ *   server's timestamps are followed
+ * @audio_sync: whether the video follows the audio clock (lip sync)
+ *
+ * Statistics of one video stream, see spice_display_channel_get_stream_stats().
+ * A spice-mac addition.
+ */
+typedef struct {
+    guint32      id;
+    gint         codec_type;
+    const gchar *decoder;
+    gint         width;
+    gint         height;
+    guint32      frames_received;
+    guint32      frames_shown;
+    guint32      frames_late;
+    guint32      frames_dropped;
+    gint32       playout_delay;
+    gint32       playout_target;
+    gboolean     audio_sync;
+} SpiceDisplayStreamStats;
+
