+/**
+ * spice_display_channel_set_stream_playout:
+ * @channel: a #SpiceDisplayChannel
+ * @delay_ms: how long after arrival to show a video frame when no audio is
+ *   playing, or 0 to follow the server's timestamps
+ *
+ * Overrides SPICE_STREAM_PLAYOUT_MS (default 50) for @channel, from the next
+ * frame on. Call it from the main context. A spice-mac addition.
+ */
+void spice_display_channel_set_stream_playout(SpiceChannel *channel, gint delay_ms)
+{
+    SpiceDisplayChannelPrivate *c;
+    gboolean own_clock;
+
+    g_return_if_fail(SPICE_IS_DISPLAY_CHANNEL(channel));
+    c = SPICE_DISPLAY_CHANNEL(channel)->priv;
+    delay_ms = MAX(delay_ms, 0);
+    if (delay_ms == c->playout_target) {
+        return;
+    }
+    CHANNEL_DEBUG(channel, "playout: target %d ms", delay_ms);
+    own_clock = c->playout_target > 0;
+    c->playout_target = delay_ms;
+    c->playout_valid = FALSE;   /* measure the shift again at the next frame */
+    if (own_clock != (delay_ms > 0)) {
+        /* the frames are played against the other clock from now on */
+        c->playout_based = FALSE;
+        c->playout_audio = FALSE;
+        c->playout_audio_since = 0;
+        display_reschedule_streams(channel);
+    }
+}
+
+/**
+ * spice_display_channel_get_stream_stats:
+ * @channel: a #SpiceDisplayChannel
+ * @stats: (array length=max_stats) (out caller-allocates): where to store them
+ * @max_stats: the size of @stats
+ *
+ * Gets the statistics of the video streams in @channel. Call it from the main
+ * context. A spice-mac addition.
+ *
+ * Returns: the number of streams stored in @stats
+ */
+guint spice_display_channel_get_stream_stats(SpiceChannel *channel, SpiceDisplayStreamStats *stats,
+                                             guint max_stats)
+{
+    SpiceDisplayChannelPrivate *c;
+    guint n = 0;
+
+    g_return_val_if_fail(SPICE_IS_DISPLAY_CHANNEL(channel), 0);
+    c = SPICE_DISPLAY_CHANNEL(channel)->priv;
+
+    for (int i = 0; i < c->nstreams && n < max_stats; i++) {
+        display_stream *st = c->streams[i];
+
+        if (st == NULL || st->video_decoder == NULL) {
+            continue;
+        }
+        stats[n++] = (SpiceDisplayStreamStats) {
+            .id = st->id,
+            .codec_type = st->video_decoder->codec_type,
+            .decoder = st->decoder_name,
+            .width = st->dest.right - st->dest.left,
+            .height = st->dest.bottom - st->dest.top,
+            .frames_received = st->num_input_frames,
+            .frames_shown = st->shown_total,
+            .frames_late = st->arrive_late_count,
+            .frames_dropped = st->num_drops_on_playback,
+            .playout_delay = st->shown_margin,
+            .playout_target = c->playout_target,
+            .audio_sync = c->playout_target > 0 && c->playout_audio,
+        };
+    }
+    return n;
+}
