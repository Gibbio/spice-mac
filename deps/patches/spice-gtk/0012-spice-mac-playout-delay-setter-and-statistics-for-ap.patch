+/**
+ * spice_channel_get_tls_info:
+ * @channel: a #SpiceChannel
+ * @version: (out) (transfer none) (optional): the TLS version, e.g. "TLSv1.3"
+ * @cipher: (out) (transfer none) (optional): the cipher suite
+ *
+ * Call it from the main context. A spice-mac addition.
+ *
+ * Returns: %TRUE if @channel is connected over TLS
+ */
+gboolean spice_channel_get_tls_info(SpiceChannel *channel, const gchar **version, const gchar **cipher)
+{
+    SpiceChannelPrivate *c;
+
+    g_return_val_if_fail(SPICE_IS_CHANNEL(channel), FALSE);
+    c = channel->priv;
+
+    if (c->ssl == NULL) {
+        return FALSE;
+    }
+    if (version != NULL) {
+        *version = SSL_get_version(c->ssl);
+    }
+    if (cipher != NULL) {
+        *cipher = SSL_get_cipher_name(c->ssl);
+    }
+    return TRUE;
+}
